<Window x:Class="QuizBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Builder"
        Height="400"
        Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Window.Resources>

        <!-- Button Style -->
        <Style x:Key="QuizButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4338CA"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3730A3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#4F46E5"
                Padding="20">

            <TextBlock Text="Quiz Builder"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="15"
                Margin="80,30"
                Padding="25">

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="250">

                <TextBlock Text="Welcome!"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <Button x:Name="ManageQuestionsButton"
                        Content="Manage Questions"
                        Style="{StaticResource QuizButtonStyle}"
                        Click="ManageQuestionsButton_Click"/>

                <Button x:Name="StartQuizButton"
                        Content="Take Quiz"
                        Style="{StaticResource QuizButtonStyle}"
                        Click="StartQuizButton_Click"/>

                <Button x:Name="ExitButton"
                        Content="Exit"
                        Style="{StaticResource QuizButtonStyle}"
                        Background="#EF4444"
                        Click="ExitButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>