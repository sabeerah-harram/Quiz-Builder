<Window x:Class="QuizBuilder.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Results"
        Height="480"
        Width="650"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3F51B5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#303F9F"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1A237E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListView Style -->
        <Style TargetType="ListView">
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>

        <!-- GridView Header Style -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#3F51B5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

    </Window.Resources>

    <Border Background="White"
            CornerRadius="12"
            Margin="15"
            Padding="20">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Summary -->
            <TextBlock x:Name="SummaryText"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#3F51B5"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Results Table -->
            <ListView x:Name="AnswersList"
                      Grid.Row="1">

                <ListView.View>
                    <GridView>

                        <GridViewColumn Header="Question"
                                        Width="230"
                                        DisplayMemberBinding="{Binding QuestionText}"/>

                        <GridViewColumn Header="Your Answer"
                                        Width="110"
                                        DisplayMemberBinding="{Binding SelectedAnswer}"/>

                        <GridViewColumn Header="Correct Answer"
                                        Width="120"
                                        DisplayMemberBinding="{Binding CorrectAnswer}"/>

                        <GridViewColumn Header="Result"
                                        Width="70"
                                        DisplayMemberBinding="{Binding IsCorrect}"/>

                    </GridView>
                </ListView.View>

            </ListView>

            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button Content="📄 Export to CSV"
                        Width="140"
                        Height="40"
                        Click="ExportButton_Click"/>

                <Button Content="Close"
                        Width="90"
                        Height="40"
                        Margin="10,0,0,0"
                        Background="#E53935"
                        Click="CloseButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>