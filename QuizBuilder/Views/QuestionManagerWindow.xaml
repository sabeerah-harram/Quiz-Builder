<Window x:Class="QuizBuilder.Views.QuestionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Question Manager"
        Height="600"
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#EEF3F8">

    <Window.Resources>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <!-- DataGrid Header -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Border Margin="15"
            CornerRadius="12"
            Background="White"
            Padding="20">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filter Section -->
            <Border Background="#EFF6FF"
            CornerRadius="10"
            Padding="15"
            Margin="0,0,0,15">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Topic:"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Margin="0,0,5,0"/>

                    <TextBox x:Name="TopicFilterBox"
                     Width="120"/>

                    <TextBlock Text="Difficulty:"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Margin="15,0,5,0"/>

                    <ComboBox x:Name="DifficultyFilterBox"
                      Width="120">
                        <ComboBoxItem Content="Any"/>
                        <ComboBoxItem Content="Easy"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="Hard"/>
                    </ComboBox>

                    <TextBlock Text="Keyword:"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Margin="15,0,5,0"/>

                    <TextBox x:Name="KeywordFilterBox"
                     Width="170"/>

                    <Button Content="🔍 Search"
                    Width="90"
                    Click="SearchButton_Click"/>

                    <Button Content="Clear"
                    Width="80"
                    Background="#64748B"
                    Click="ClearFilterButton_Click"/>

                </StackPanel>

            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- DataGrid -->
                <DataGrid x:Name="QuestionsGrid"
                  Grid.Column="0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="QuestionsGrid_SelectionChanged"
                  Margin="0,5,10,5">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Question"
                                    Binding="{Binding Text}"
                                    Width="3*"/>

                        <DataGridTextColumn Header="Topic"
                                    Binding="{Binding Topic}"
                                    Width="*"/>

                        <DataGridTextColumn Header="Difficulty"
                                    Binding="{Binding Difficulty}"
                                    Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

                <!-- Details Panel -->
                <Border Grid.Column="1"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15"
                Margin="10,5,0,5">

                    <StackPanel>

                        <TextBlock Text="Question Details"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#2563EB"
                           Margin="0,0,0,15"/>

                        <TextBlock Text="Question:"
                           FontWeight="Bold"/>

                        <TextBlock x:Name="QuestionDetailsText"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                        <TextBlock Text="Topic:"
                           FontWeight="Bold"/>

                        <TextBlock x:Name="TopicDetailsText"
                           Margin="0,0,0,10"/>

                        <TextBlock Text="Difficulty:"
                           FontWeight="Bold"/>

                        <TextBlock x:Name="DifficultyDetailsText"
                           Margin="0,0,0,10"/>

                        <TextBlock Text="Correct Answer:"
                           FontWeight="Bold"/>

                        <TextBlock x:Name="CorrectAnswerDetailsText"
                           TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- Bottom Buttons -->
            <StackPanel Orientation="Horizontal"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Margin="0,20,0,0">

                <Button Content="➕ Add"
                Width="90"
                Click="AddButton_Click"/>

                <Button Content="✏ Edit"
                Width="90"
                Background="#F59E0B"
                Click="EditButton_Click"/>

                <Button Content="🗑 Delete"
                Width="90"
                Background="#DC2626"
                Click="DeleteButton_Click"/>

                <Button Content="💾 Save XML"
                Width="110"
                Background="#059669"
                Click="SaveButton_Click"/>

                <Button Content="Close"
                Width="90"
                Background="#6B7280"
                Click="CloseButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>